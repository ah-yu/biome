pattern for_in_loop() {
    or {
        `for(µ_ in µ_) { µ_ }`,
        `for(let µ_ in µ_) { µ_ }`,
        `for(const µ_ in µ_) { µ_ }`,
        `for(var µ_ in µ_) { µ_ }`,
    }
}

pattern for_of_loop() {
    or {
        `for(µ_ of µ_) { µ_ }`,
        `for(let µ_ of µ_) { µ_ }`,
        `for(const µ_ of µ_) { µ_ }`,
        `for(var µ_ of µ_) { µ_ }`,
        `for await(µ_ of µ_) { µ_ }`,
        `for await(let µ_ of µ_) { µ_ }`,
        `for await(const µ_ of µ_) { µ_ }`,
        `for await(var µ_ of µ_) { µ_ }`,
    }
}

pattern for_loop() {
    `for(µ_; µ_; µ_) { µ_ }` 
}

or {
    for_in_loop(),
    for_of_loop(),
    for_loop()
}